# =============================================================
# Paint Appearance backend -- EXAMPLE environment (development)
#
# Copy to `backend/.env` (gitignored) and fill in the passwords.
# Never commit a filled-in copy. Environment variables override this file.
# Every setting is described in README.md ("Configuration").
# =============================================================

ENV=development

# --- database: the API connects as app_rw ONLY -------------------------
# The API refuses to start if this URL names postgres, migrator or another
# privileged role (backend/app/core/config.py).
APP_DATABASE_URL=postgresql+psycopg://app_rw:CHANGE_ME@localhost:5432/paint_appearance

# Alembic reads MIGRATOR_DATABASE_URL, and the API never does. Set it in your
# shell when you run `alembic upgrade head`, not here:
#   MIGRATOR_DATABASE_URL=postgresql+psycopg://migrator:CHANGE_ME@localhost:5432/paint_appearance

# --- sign-in -----------------------------------------------------------
# This release has no sign-in (owner decision 2026-10-20): every request is
# one shared account with every role. Use exactly ONE of the two options.
#
# Option A (default here): open access, the same as the deployed site.
AUTH_OPEN_ACCESS=true
#
# Option B: development bypass -- a fixed local identity with chosen roles
# (viewer | engineer | admin). Honoured only when ENV=development.
AUTH_DEV_BYPASS=false
AUTH_DEV_BYPASS_ROLES=viewer,engineer,admin
# Future Ford ID / Entra sign-in (another team); unused in this release.
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# --- HTTP --------------------------------------------------------------
# Browser origins allowed to call the API (the Vite dev server). No wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Swagger UI at /docs.
API_DOCS_ENABLED=true
# Serve the built frontend (frontend/dist) from the API on one origin. Empty: API only.
STATIC_DIR=

# --- uploads and ingest ------------------------------------------------
# Where uploaded workbook bytes are kept. Empty: <repo>/data/raw (gitignored).
RAW_STORE_DIR=
UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_FILES=40
DUPLICATE_THRESHOLD=80
# The ingest worker runs inside the API process.
INGEST_WORKER_ENABLED=true
